 "faq": {
  "items": [
   {
    "q": "Patreonって何ですか？",
    "a": "クリエイターを月額で応援できる海外のサービスです。プランに参加すると、Patreonでしか見られない限定の作品を楽しめます。",
    "q_en": "What is Patreon?",
    "a_en": "An international service where you can support creators with a monthly membership. Joining a plan gives you access to exclusive works you can only see on Patreon."
   },
   {
    "q": "どうやって参加するの？",
    "a": "「会員限定」ページのボタンからPatreonを開き、好きなプランの「参加する」を押します。Patreonのアカウントを作って支払い方法を登録すれば完了です。",
    "q_en": "How do I join?",
    "a_en": "Open Patreon from the button on the Patreon page here, then press “Join” on the plan you like. Create a Patreon account, add a payment method, and you're all set."
   },
   {
    "q": "コースと推しプランの違いは？",
    "a": "コース（basic / Extra / ULTRA）は、いろいろなキャラの作品をまとめて楽しめるプランです。推しプランは、選んだ1人のキャラのコンテンツを楽しめるプランです。",
    "q_en": "What's the difference between tiers and oshi plans?",
    "a_en": "Tiers (Basic / Extra / ULTRA) let you enjoy works featuring all the characters. Oshi plans let you enjoy the content of the one character you choose."
   },
   {
    "q": "無料で試せますか？",
    "a": "「もっとみたいコース（basic）」は7日間の無料お試しがあります。",
    "q_en": "Can I try it for free?",
    "a_en": "The “Want to See More” (Basic) tier has a 7-day free trial."
   },
   {
    "q": "料金や支払い方法は？",
    "a": "料金はドル（$）建ての月額です。日本円での金額は為替によって少し変わります。支払い方法はPatreonの画面で選べます。",
    "q_en": "How much does it cost, and how do I pay?",
    "a_en": "Prices are monthly, in US dollars. You can choose your payment method on Patreon."
   },
   {
    "q": "プランの変更や解約はできますか？",
    "a": "Patreonのメンバーシップ設定から、いつでもプランの変更や解約ができます。",
    "q_en": "Can I change or cancel my plan?",
    "a_en": "Yes. You can change or cancel anytime from your membership settings on Patreon."
   },
   {
    "q": "18歳未満でも参加できますか？",
    "a": "一部のプランには成人向けの内容が含まれるため、18歳未満の方はご利用いただけません。",
    "q_en": "Can I join if I'm under 18?",
    "a_en": "Some plans include adult content, so they are not available to anyone under 18."
   }
  ],
  "note": "※ 料金・お試し・解約などの細かい条件は、Patreonの表示が最新です。",
  "note_en": "* For the latest details on pricing, trials and cancellation, please check Patreon."
 },
